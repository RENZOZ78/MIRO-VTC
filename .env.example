# Copier ce fichier en .env.local et renseigner les valeurs.
# .env.local est ignoré par Git : ne jamais mettre de clé dans le code.

# URL publique du site (sans slash final). Sert aux redirections Stripe,
# au sitemap et aux liens dans les e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (facultatif tant que le paiement en ligne n'est pas activé) ---
# Sans STRIPE_SECRET_KEY, la réservation est confirmée par e-mail et réglée à bord.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SMTP (envoi des e-mails de réservation et de contact) ---
# Sans SMTP_HOST, les e-mails sont simulés et affichés dans la console serveur.
SMTP_HOST=
SMTP_PORT=587
# "true" pour SMTPS (port 465), "false" pour STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Adresse d'expédition affichée aux clients (ex. "MIRO VTC <contact@miro-vtc.fr>")
MAIL_FROM=
# Adresse qui reçoit les réservations et les messages de contact
MAIL_TO=
